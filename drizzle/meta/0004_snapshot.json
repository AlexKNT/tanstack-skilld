      "checkConstraints": {
        "skills_visibility_allowed": {
          "name": "skills_visibility_allowed",
          "value": "\"skills\".\"visibility\" in ('published', 'hidden')"
        },
        "skills_moderation_reason_length": {
          "name": "skills_moderation_reason_length",
          "value": "\"skills\".\"moderation_reason\" is null or char_length(btrim(\"skills\".\"moderation_reason\")) between 1 and 200"
        },
        "skills_tags_check": {
          "name": "skills_tags_check",
          "value": "cardinality(\"skills\".\"tags\") <= 5 and skills_tags_valid(\"skills\".\"tags\")"
        },
        "skills_slug_lowercase_url_safe": {
          "name": "skills_slug_lowercase_url_safe",
          "value": "\"skills\".\"slug\" ~ '^[a-z0-9]+(?:-[a-z0-9]+)*$'"
        },
        "skills_slug_length": {
          "name": "skills_slug_length",
          "value": "char_length(\"skills\".\"slug\") between 1 and 60"
        },
        "skills_name_not_blank": {
          "name": "skills_name_not_blank",
          "value": "char_length(btrim(\"skills\".\"name\")) between 1 and 80"
        },
        "skills_summary_not_blank": {
          "name": "skills_summary_not_blank",
          "value": "char_length(btrim(\"skills\".\"summary\")) between 1 and 200"
        },
        "skills_description_not_blank": {
          "name": "skills_description_not_blank",
          "value": "char_length(btrim(\"skills\".\"description\")) >= 1"
        },
        "skills_timestamps_ordered": {
          "name": "skills_timestamps_ordered",
          "value": "\"skills\".\"updated_at\" >= \"skills\".\"created_at\""
