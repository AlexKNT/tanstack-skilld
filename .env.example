# Copy this file to .env.local and fill in the values from https://dashboard.clerk.com
# The Clerk CLI writes these for you when you run `clerk init`.

VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostHog client-side analytics
VITE_POSTHOG_PROJECT_TOKEN=<ph_project_token>
VITE_POSTHOG_HOST=<ph_client_api_host>

# Postgres connection string, read on the server only. Never prefix this with
# VITE_, or it reaches the browser bundle.
#
# Any Postgres works: a local server, Neon, or Supabase. A Supabase project
# gives you this under Project Settings -> Database -> Connection string. Use
# the Session pooler, which is reachable over IPv4, and take the database
# password from there rather than the publishable API key.
#
# On a hosted pooler whose certificate is not in Node's trust store, keep both
# query parameters. A plain sslmode=require is treated as full verification and
# is refused before the password is ever checked.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
DATABASE_URL=<postgres_connection_string>
